//=================================================================================================
// Пиксельный шейдер для цветного треугольника
//=================================================================================================

struct PSInput {
    float4 position : SV_POSITION;  // Позиция (не используется, но нужна для совместимости)
    float4 color : COLOR;            // Цвет от вершинного шейдера
};

float4 main(PSInput input) : SV_TARGET {
    // Просто возвращаем цвет, интерполированный между вершинами
    return input.color;
}